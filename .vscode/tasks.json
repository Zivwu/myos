{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "nasm -f bin boot.s -o boot.bin"
        },
        {
            "label": "start qemu",
            "type": "shell",
            "command": "qemu-system-x86_64 -drive format=raw,file=boot.bin -S -s",
            "problemMatcher": []
        },
        {
            "label": "stop qemu",
            "type": "shell",
            "command": "pkill qemu-system-x86_64",
            "problemMatcher": []
        }
    ]
}
